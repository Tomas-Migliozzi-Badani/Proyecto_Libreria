{
  "info": {
    "name": "Libreria - API JWT",
    "description": "API del proyecto integrador. Ejecutar carpetas en orden contra una base de desarrollo. Crea un producto de prueba y una reserva, luego los da de baja. Requiere una categoria activa y la cuenta cliente vinculada. Las contrasenas incluidas son solo las cuentas demo documentadas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5063"
    },
    {
      "key": "email",
      "value": "administrador@libreria.test"
    },
    {
      "key": "password",
      "value": "123"
    },
    {
      "key": "clienteEmail",
      "value": "cliente@libreria.test"
    },
    {
      "key": "clientePassword",
      "value": "Libreria2026!"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "clienteToken",
      "value": ""
    },
    {
      "key": "categoriaId",
      "value": ""
    },
    {
      "key": "productoId",
      "value": ""
    },
    {
      "key": "reservaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Autenticacion y consultas",
      "item": [
        {
          "name": "Login administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"token\", pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Mi identidad JWT",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar categorias y elegir una activa",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categorias?pagina=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const c = pm.response.json().elementos.find(c => c.estado); if (c) pm.collectionVariables.set(\"categoriaId\", c.idCategoria); else pm.test(\"Crear una categoria activa desde el sitio\", () => pm.expect.fail(\"Falta categoria activa\")); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/productos?pagina=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar clientes (personal)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/clientes?pagina=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 - Alta y modificacion de producto",
      "item": [
        {
          "name": "Crear producto de prueba",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/productos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Producto prueba Postman\",\n  \"marca\": \"Demostracion\",\n  \"precio\": 1500.5,\n  \"stock\": 10,\n  \"idCategoria\": {{categoriaId}},\n  \"estado\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"productoId\", pm.response.json().idProducto);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar producto creado",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/productos/{{productoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Editar producto de prueba",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/productos/{{productoId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Producto prueba Postman editado\",\n  \"marca\": \"Demostracion\",\n  \"precio\": 1600.5,\n  \"stock\": 10,\n  \"idCategoria\": {{categoriaId}},\n  \"estado\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 - Reservas del cliente",
      "item": [
        {
          "name": "Login cliente de demostracion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{clienteEmail}}\",\n  \"password\": \"{{clientePassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"clienteToken\", pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reservar como cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/reservas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"detalles\": [\n    {\n      \"idProducto\": {{productoId}},\n      \"cantidad\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clienteToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"reservaId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Mis reservas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/reservas?pagina=1",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clienteToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalle propio",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/reservas/{{reservaId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clienteToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4 - Comprobar controles",
      "item": [
        {
          "name": "Sin token devuelve 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/productos",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cliente no consulta datos de clientes - 403",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/clientes",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clienteToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cliente no crea productos - 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/productos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"No permitido\",\n  \"precio\": 1,\n  \"stock\": 1,\n  \"idCategoria\": 1,\n  \"estado\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clienteToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reserva inexistente - 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/reservas/2147483647",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clienteToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5 - Cancelar y desactivar datos de prueba",
      "item": [
        {
          "name": "Cancelar reserva propia",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/reservas/{{reservaId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clienteToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancelar otra vez no duplica stock",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/reservas/{{reservaId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clienteToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Desactivar producto de prueba",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/productos/{{productoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6 - Cerrar sesiones API",
      "item": [
        {
          "name": "Invalidar tokens del administrador",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Token anterior ya no sirve - 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
