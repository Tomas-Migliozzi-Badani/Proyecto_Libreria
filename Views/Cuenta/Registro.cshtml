@model Proyecto_Libreria.ViewModels.RegistroFormulario
@{ ViewData["Title"] = "Crear cuenta"; }
<div class="row justify-content-center"><section class="col-md-8 col-lg-6"><div class="card card-body">
<h1 class="h3">Crear mi cuenta</h1><p>Registrate para reservar productos y consultar tus reservas.</p>
<form asp-action="Registro" method="post">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="row g-3">
<div class="col-md-6"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" required maxlength="100" autocomplete="given-name" /></div>
<div class="col-md-6"><label asp-for="Apellido" class="form-label"></label><input asp-for="Apellido" class="form-control" required maxlength="100" autocomplete="family-name" /></div>
<div class="col-md-6"><label asp-for="Dni" class="form-label">DNI sin puntos</label><input asp-for="Dni" class="form-control" required pattern="[0-9]{7,9}" maxlength="9" inputmode="numeric" /></div>
<div class="col-md-6"><label asp-for="Telefono" class="form-label">Teléfono</label><input asp-for="Telefono" class="form-control" required maxlength="30" autocomplete="tel" /></div>
<div class="col-12"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" required maxlength="254" autocomplete="username" /></div>
<div class="col-md-6"><label asp-for="Password" class="form-label">Contraseña</label><input asp-for="Password" class="form-control" required minlength="8" maxlength="100" autocomplete="new-password" /></div>
<div class="col-md-6"><label asp-for="ConfirmarPassword" class="form-label">Confirmar contraseña</label><input asp-for="ConfirmarPassword" class="form-control" required minlength="8" maxlength="100" autocomplete="new-password" /></div>
</div><p class="small text-muted mt-3">La contraseña debe tener al menos 8 caracteres. La cuenta se crea con permisos de cliente.</p>
<button class="btn btn-primary">Crear cuenta</button><a class="btn btn-link" asp-action="Login">Ya tengo cuenta</a>
</form></div></section></div>
