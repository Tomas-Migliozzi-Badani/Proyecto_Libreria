@model Proyecto_Libreria.ViewModels.LoginFormulario
@{ ViewData["Title"] = "Iniciar sesion"; }
<div class="row justify-content-center"><section class="col-md-6 col-lg-4">
<div class="card card-body shadow-sm"><h1 class="h3">Iniciar sesión</h1>
<p class="text-muted">Ingresá con tu cuenta de la librería.</p>
@if (TempData["RegistroExitoso"] is string aviso) { <div class="alert alert-success" role="status">@aviso</div> }
<form asp-controller="Cuenta" asp-action="Login" method="post">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<input asp-for="ReturnUrl" type="hidden" />
<label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control" autocomplete="username" required />
<label asp-for="Password" class="form-label mt-3">Contraseña</label><input asp-for="Password" class="form-control" autocomplete="current-password" required />
<label class="form-check my-3"><input asp-for="Recordarme" class="form-check-input" /> Recordarme en este equipo</label>
<button class="btn btn-primary w-100">Ingresar</button>
</form><a class="mt-3" asp-action="Registro">No tengo cuenta: registrarme</a></div></section></div>
