@{
    ViewData["Title"] = "Categorias";
}
<div id="categorias-app" data-base="@Url.Content("~/Categorias")">
    @Html.AntiForgeryToken()
    <h1>Categorías</h1>
    <p class="text-muted">Organizá los productos de la librería. Podés reactivar una categoría desde Editar.</p>
    <div v-if="false" class="alert alert-info">Cargando categorías…</div>
    <div v-cloak>
        <div v-if="mensaje" class="alert" :class="error ? 'alert-danger' : 'alert-success'" role="status">{{ mensaje }}</div>
        <div class="row g-4">
            <section class="col-lg-4" aria-labelledby="formulario-titulo">
                <div class="card card-body">
                    <h2 id="formulario-titulo" class="h5">{{ editando ? 'Editar categoría' : 'Nueva categoría' }}</h2>
                    <form v-on:submit.prevent="guardar">
                        <label for="nombre-categoria" class="form-label">Nombre</label>
                        <input id="nombre-categoria" class="form-control" v-model="formulario.nombre" required maxlength="100" :disabled="guardando" />
                        <div class="form-check my-3">
                            <input id="estado-categoria" type="checkbox" class="form-check-input" v-model="formulario.estado" :disabled="guardando" />
                            <label for="estado-categoria" class="form-check-label">Activa</label>
                        </div>
                        <button class="btn btn-primary" :disabled="guardando">{{ guardando ? 'Guardando…' : 'Guardar' }}</button>
                        <button v-if="editando" type="button" class="btn btn-outline-secondary ms-2" v-on:click="cancelar" :disabled="guardando">Cancelar</button>
                    </form>
                </div>
            </section>
            <section class="col-lg-8" aria-label="Listado de categorias">
                <form class="d-flex gap-2 mb-3" v-on:submit.prevent="cargar(1)">
                    <input type="search" class="form-control" placeholder="Buscar por nombre" aria-label="Buscar por nombre" v-model="buscar" maxlength="100" />
                    <button class="btn btn-outline-primary" :disabled="cargando">Buscar</button>
                </form>
                <p v-if="cargando" role="status">Cargando…</p>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead><tr><th>Nombre</th><th>Estado</th><th>Acciones</th></tr></thead>
                        <tbody>
                            <tr v-for="categoria in elementos" :key="categoria.idCategoria">
                                <td>{{ categoria.nombre }}</td>
                                <td><span class="badge" :class="categoria.estado ? 'bg-success' : 'bg-secondary'">{{ categoria.estado ? 'Activa' : 'Inactiva' }}</span></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-2" v-on:click="editar(categoria)" :disabled="guardando">Editar</button>
                                    <button v-if="categoria.estado" class="btn btn-sm btn-outline-danger" v-on:click="desactivar(categoria)" :disabled="guardando">Desactivar</button>
                                </td>
                            </tr>
                            <tr v-if="!cargando && elementos.length === 0"><td colspan="3">No hay categorías para esta búsqueda.</td></tr>
                        </tbody>
                    </table>
                </div>
                <nav class="d-flex align-items-center justify-content-between" aria-label="Paginacion">
                    <button class="btn btn-outline-secondary" v-on:click="cargar(pagina - 1)" :disabled="pagina <= 1 || cargando || guardando">Anterior</button>
                    <span>Página {{ pagina }} de {{ paginas }} · {{ total }} categorías</span>
                    <button class="btn btn-outline-secondary" v-on:click="cargar(pagina + 1)" :disabled="pagina >= paginas || cargando || guardando">Siguiente</button>
                </nav>
            </section>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/lib/vue/vue.global.prod.js" asp-append-version="true"></script>
    <script src="~/js/categorias.js" asp-append-version="true"></script>
}
