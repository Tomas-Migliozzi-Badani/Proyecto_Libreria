@{ ViewData["Title"] = "Catalogo"; }
<div id="catalogo-app" data-imagenes="@Url.Content("~/imagenes/")" data-base="@Url.Content("~/Catalogo")" data-confirmar="@Url.Action("Crear", "MisReservas")" data-cliente="@User.IsInRole("Cliente").ToString().ToLowerInvariant()" data-autenticado="@((User.Identity?.IsAuthenticated == true).ToString().ToLowerInvariant())">
@Html.AntiForgeryToken()
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h1>Catálogo de la librería</h1><p class="text-muted">Elegí tus productos y reservalos para retirar en el local.</p></div><a asp-controller="MisReservas" asp-action="Index" class="btn btn-outline-primary" style="display:@(User.IsInRole("Cliente") ? "inline-block" : "none")">Mis reservas</a></div>
<div v-cloak>
<div v-if="mensaje" class="alert" :class="error ? 'alert-danger' : 'alert-success'" role="status">{{ mensaje }}</div>
<div class="row g-4">
<section class="col-lg-8" aria-label="Productos del catalogo">
<form class="d-flex gap-2 mb-3" v-on:submit.prevent="cargar(1)"><input class="form-control" type="search" v-model="buscar" maxlength="100" aria-label="Buscar productos" placeholder="Buscar por nombre o marca" /><button class="btn btn-outline-primary" :disabled="cargando">Buscar</button></form>
<p v-if="cargando" role="status">Cargando productos…</p>
<div class="row g-3"><article class="col-md-6 col-xl-4" v-for="producto in productos" :key="producto.idProducto"><div class="card h-100"><div class="card-body d-flex flex-column">
<img v-if="producto.imagen" :src="imagenUrl(producto.imagen)" :alt="producto.nombre" class="w-100 mb-3" height="180" style="object-fit:contain" loading="lazy" />
<small class="text-muted">{{ producto.categoria }}</small><h2 class="h5 mt-1">{{ producto.nombre }}</h2><p class="text-muted">{{ producto.marca }}</p><p class="fs-5 fw-bold">{{ moneda(producto.precio) }}</p>
<p :class="producto.stock > 0 ? 'text-success' : 'text-secondary'">{{ producto.stock > 0 ? 'Disponibles: ' + producto.stock : 'Sin stock' }}</p>
<div class="mt-auto"><label :for="'cantidad-' + producto.idProducto" class="form-label">Cantidad</label><input :id="'cantidad-' + producto.idProducto" class="form-control mb-2" type="number" min="1" :max="producto.stock" step="1" v-model.number="cantidades[producto.idProducto]" :disabled="producto.stock <= 0 || guardando" />
<button class="btn btn-outline-primary w-100" v-on:click="agregar(producto)" :disabled="producto.stock <= 0 || guardando">Agregar a mi reserva</button></div>
</div></div></article></div>
<p v-if="!cargando && !productos.length" class="alert alert-light">No encontramos productos activos para esta búsqueda.</p>
<nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Paginacion del catalogo"><button class="btn btn-outline-secondary" :disabled="pagina <= 1 || cargando" v-on:click="cargar(pagina - 1)">Anterior</button><span>{{ pagina }} / {{ paginas }} · {{ total }} productos</span><button class="btn btn-outline-secondary" :disabled="pagina >= paginas || cargando" v-on:click="cargar(pagina + 1)">Siguiente</button></nav>
</section>
<aside class="col-lg-4" aria-label="Mi seleccion"><div class="card card-body"><h2 class="h4">Mi selección</h2>
<p v-if="!carrito.length">Todavía no agregaste productos.</p>
<ul class="list-group list-group-flush"><li v-for="(linea, indice) in carrito" :key="linea.idProducto" class="list-group-item px-0"><strong>{{ linea.nombre }}</strong><label :for="'carrito-' + linea.idProducto" class="small d-block">Cantidad</label><input :id="'carrito-' + linea.idProducto" class="form-control" type="number" min="1" max="1000000" step="1" v-model.number="linea.cantidad" :disabled="guardando" /><div class="d-flex justify-content-between mt-2"><span>{{ moneda(linea.precio * linea.cantidad) }}</span><button type="button" class="btn btn-sm btn-outline-danger" v-on:click="carrito.splice(indice, 1)" :disabled="guardando">Quitar</button></div></li></ul>
<p class="fw-bold mt-3">Total estimado: {{ moneda(totalCarrito) }}</p>
<p class="small text-muted">Precios y disponibilidad se verifican al confirmar. La reserva no implica un pago.</p>
@if (User.IsInRole("Cliente"))
{
<button class="btn btn-primary" v-on:click="confirmar" :disabled="guardando || !carrito.length">{{ guardando ? 'Confirmando…' : 'Confirmar reserva' }}</button>
<a class="btn btn-link mt-2" asp-controller="MisReservas" asp-action="Index">Ver mis reservas</a>
}
else if (User.Identity?.IsAuthenticated != true)
{
<a class="btn btn-primary" asp-controller="Cuenta" asp-action="Login" asp-route-returnUrl="@Url.Action("Index", "Catalogo")">Iniciar sesión para reservar</a>
<a class="btn btn-outline-primary mt-2" asp-controller="Cuenta" asp-action="Registro">Crear mi cuenta</a>
}
else
{
<p class="small">Estás usando una cuenta del personal. Registrá reservas desde el módulo de administración.</p>
<a class="btn btn-outline-primary" asp-controller="Reservas" asp-action="Index">Administrar reservas</a>
}
</div></aside></div></div></div>
@section Scripts {
<script src="~/lib/vue/vue.global.prod.js" asp-append-version="true"></script>
<script src="~/js/catalogo.js" asp-append-version="true"></script>
}
