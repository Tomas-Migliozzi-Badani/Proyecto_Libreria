@{ ViewData["Title"] = "Clientes"; }
<div id="personas-app" data-tipo="Clientes" data-base="@Url.Content("~/Clientes")">
@Html.AntiForgeryToken()
<h1>Clientes</h1>
<div v-cloak>
<div v-if="mensaje" class="alert" :class="error ? 'alert-danger' : 'alert-success'" role="status">{{ mensaje }}</div>
<div class="row g-4">
<section class="col-lg-4"><div class="card card-body">
<h2 class="h5">{{ editando ? 'Editar registro' : 'Nuevo registro' }}</h2>
<form v-on:submit.prevent="guardar"><fieldset :disabled="guardando">
<label for="nombre" class="form-label">Nombre</label><input id="nombre" class="form-control" required maxlength="100" v-model="formulario.nombre" />
<label for="apellido" class="form-label mt-2">Apellido</label><input id="apellido" class="form-control" required maxlength="100" v-model="formulario.apellido" />
<label for="email" class="form-label mt-2">Email</label><input id="email" class="form-control" type="email" required maxlength="254" v-model="formulario.email" />
<label for="dni" class="form-label mt-2">DNI (sin puntos)</label><input id="dni" class="form-control" v-model="formulario.dni" required pattern="[0-9]{7,9}" maxlength="9" />
<label for="telefono" class="form-label mt-2">Teléfono</label><input id="telefono" class="form-control" v-model="formulario.telefono" required maxlength="30" />
<button class="btn btn-primary mt-3">{{ guardando ? 'Guardando…' : 'Guardar' }}</button>
<button v-if="editando" type="button" class="btn btn-outline-secondary ms-2 mt-3" v-on:click="cancelar">Cancelar</button>
</fieldset></form></div></section>
<section class="col-lg-8">
<form class="d-flex gap-2 mb-3" v-on:submit.prevent="cargar(1)"><input class="form-control" type="search" aria-label="Buscar" placeholder="Buscar" maxlength="100" v-model="buscar" /><button class="btn btn-outline-primary" :disabled="cargando">Buscar</button></form>
<p v-if="cargando" role="status">Cargando…</p>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Nombre</th><th>Email</th><th>DNI / teléfono</th><th>Acciones</th></tr></thead>
<tbody><tr v-for="item in elementos" :key="item.id"><td>{{ item.apellido }}, {{ item.nombre }}</td><td>{{ item.email }}</td><td>{{ item.dni }} · {{ item.telefono }}</td>
<td><button class="btn btn-sm btn-outline-primary me-2" :disabled="guardando" v-on:click="editar(item)">Editar</button><button class="btn btn-sm btn-outline-danger" :disabled="guardando" v-on:click="eliminar(item)">Eliminar</button></td></tr>
<tr v-if="!cargando && !elementos.length"><td colspan="4">No hay resultados.</td></tr></tbody></table></div>
<nav class="d-flex justify-content-between align-items-center" aria-label="Paginacion"><button class="btn btn-outline-secondary" :disabled="pagina <= 1 || cargando || guardando" v-on:click="cargar(pagina - 1)">Anterior</button><span>Página {{ pagina }} de {{ paginas }} · {{ total }} registros</span><button class="btn btn-outline-secondary" :disabled="pagina >= paginas || cargando || guardando" v-on:click="cargar(pagina + 1)">Siguiente</button></nav>
</section></div></div></div>
@section Scripts {
<script src="~/lib/vue/vue.global.prod.js" asp-append-version="true"></script>
<script src="~/js/personas.js" asp-append-version="true"></script>
}
